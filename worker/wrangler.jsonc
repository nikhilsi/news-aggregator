{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clearnews",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Until the switchover the Worker is reached on workers.dev only. At the
  // switchover, getclearnews.com and www.getclearnews.com are attached as
  // custom domains by script (docs/deploy-runbook.md), then workers_dev goes off.
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  // Every minute: refresh due feeds into KV (spec section 4).
  "triggers": { "crons": ["* * * * *"] },
  "assets": {
    "directory": "../web/out",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "kv_namespaces": [
    // "clearnews-cache", created Nov 1, 2026 with the ClearNews token.
    { "binding": "CACHE", "id": "b1f53c4848ae4fff8cdc3807f8b8666b" }
  ],
  // Approximate, per Cloudflare location. 3001 is TourGraph's, 2001 and 2002 Recurate's.
  "ratelimits": [
    { "name": "API_LIMITER", "namespace_id": "4001", "simple": { "limit": 100, "period": 10 } },
    { "name": "READER_LIMITER", "namespace_id": "4002", "simple": { "limit": 20, "period": 60 } }
  ]
}
