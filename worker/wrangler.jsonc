{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clearnews",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Live on getclearnews.com since the Nov 1, 2026 switchover (custom domains
  // attached by scripts/cutover.mjs). The workers.dev address is off so there is
  // one origin. ROLLBACK to the droplet: remove these routes first, or the next
  // deploy takes the hostnames back (docs/deploy-runbook.md).
  "routes": [
    { "pattern": "getclearnews.com", "custom_domain": true },
    { "pattern": "www.getclearnews.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  // Every minute: refresh due feeds into KV (spec section 4).
  "triggers": { "crons": ["* * * * *"] },
  "assets": {
    "directory": "../web/out",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "kv_namespaces": [
    // "clearnews-cache", created Nov 1, 2026 with the ClearNews token.
    { "binding": "CACHE", "id": "b1f53c4848ae4fff8cdc3807f8b8666b" }
  ],
  // Approximate, per Cloudflare location. 3001 is TourGraph's, 2001 and 2002 Recurate's.
  "ratelimits": [
    { "name": "API_LIMITER", "namespace_id": "4001", "simple": { "limit": 100, "period": 10 } },
    { "name": "READER_LIMITER", "namespace_id": "4002", "simple": { "limit": 20, "period": 60 } }
  ]
}
